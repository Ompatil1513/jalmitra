WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Production: comma-separated frontend URLs (no trailing slash)
# Example: https://jalmitra.vercel.app,https://jalmitra.netlify.app
CORS_ORIGINS=
